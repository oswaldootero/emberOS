# ============================================================
# EmberOS — Environment Configuration
# Copy to .env.local and fill in values. Never commit .env.local.
# ============================================================

# ---------- Core ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Database (Supabase Postgres) ----------
# Use the "Transaction" pooler URL for DATABASE_URL (port 6543) and
# the "Session" pooler URL for DIRECT_URL (port 5432) when on Vercel.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=emberos-assets

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---------- Upstash (rate limiting + QStash scheduling) ----------
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
QSTASH_TOKEN=...
QSTASH_CURRENT_SIGNING_KEY=...
QSTASH_NEXT_SIGNING_KEY=...

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HeavensLeafBrotherhoodBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=

# ---------- WordPress ----------
WORDPRESS_URL=https://heavensleaf.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ---------- WooCommerce ----------
WOOCOMMERCE_URL=https://heavensleaf.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ---------- Meta (Instagram / Facebook) ----------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=
META_FACEBOOK_PAGE_ID=

# ---------- YouTube ----------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ---------- Google Search Console ----------
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=https://heavensleaf.com

# ---------- Analytics ----------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------- Cron / Internal API ----------
CRON_SECRET=replace-with-a-long-random-string
INTERNAL_API_TOKEN=replace-with-a-long-random-string
