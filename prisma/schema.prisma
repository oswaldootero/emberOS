// =============================================================
// EmberOS — Prisma Schema
// AI-powered media operating system for Heaven's Leaf
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// -----------------------------
// Enums
// -----------------------------

enum Role {
  ADMIN
  CONTENT_CREATOR
  COMMUNITY_MANAGER
  AMBASSADOR
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  YOUTUBE
  X_TWITTER
  WORDPRESS
  EMAIL
  WOOCOMMERCE
  WEB
}

enum ContentType {
  CAPTION
  BLOG_POST
  DEVOTIONAL
  TELEGRAM_POST
  SEO_ARTICLE
  EMAIL_NEWSLETTER
  VIDEO_HOOK
  PODCAST_OUTLINE
  QUOTE_GRAPHIC
  CAROUSEL
  SHORT_FORM
  STORY
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ScheduledStatus {
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  LOGO
  GRAPHIC
  TRANSCRIPT
}

enum AIJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AnalyticsSource {
  GA4
  GSC
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
  EMAIL
  CUSTOM
}

enum TelegramDraftStatus {
  PENDING    // AI drafted it, awaiting your eyes
  APPROVED   // You said yes — will auto-send on proposedFor day
  SENT       // Posted to Telegram
  DISCARDED  // You said no — won't send
}

enum CustomerType {
  RETAILER
  LOUNGE
  DISTRIBUTOR
  ONLINE_CUSTOMER
  EVENT_LEAD
  OTHER
}

enum LeadSource {
  BROKER
  WEBSITE
  EVENT
  REFERRAL
  SOCIAL_MEDIA
  DIRECT_OUTREACH
}

enum CustomerStatus {
  LEAD
  PROSPECT
  CONTACTED
  SAMPLE_SENT
  OPEN_ACCOUNT
  ACTIVE_CUSTOMER
  INACTIVE
  LOST
}

enum SaleStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum SaleSource {
  EMBEROS     // invoice authored in EmberOS
  QUICKBOOKS  // imported from a QuickBooks CSV export
  EXTERNAL    // recorded manually; invoiced somewhere else
}

enum BlendType {
  MADURO
  CONNECTICUT
  HABANO
  COSECHA_DORADA
  CUSTOM
}

enum PackagingType {
  BOX
  SINGLE
  THREE_PACK
  FIVE_PACK
  BUNDLE
}

enum InventoryStatus {
  ACTIVE
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum AdjustmentReason {
  SALE
  SAMPLE
  DAMAGE
  EVENT
  RETURN
  CORRECTION
  PURCHASE
  TRANSFER
}

enum WorkflowTrigger {
  CONTENT_PUBLISHED
  MANUAL
  SCHEDULED
  TELEGRAM_MESSAGE
  WEBHOOK
  RSS_UPDATE
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

// -----------------------------
// Identity
// -----------------------------

model User {
  id              String   @id @default(cuid())
  supabaseId      String?  @unique
  email           String   @unique
  fullName        String?
  displayName     String?
  avatarUrl       String?
  role            Role     @default(CONTENT_CREATOR)
  bio             String?
  timezone        String   @default("America/Los_Angeles")
  lastSeenAt      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contentPieces       ContentPiece[]      @relation("AuthoredContent")
  approvedContent     ContentPiece[]      @relation("ApprovedContent")
  scheduledPosts      ScheduledPost[]
  aiJobs              AIJob[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  assets              Asset[]
  promptTemplates     PromptTemplate[]
  brandVoices         BrandVoice[]
  campaigns           Campaign[]
  auditLogs           AuditLog[]
  analyticsImports    AnalyticsImport[]
  forecastScenarios   ForecastScenario[]
  assignedCustomers   Customer[]        @relation("AssignedCustomers")
  inventoryAdjustments InventoryAdjustment[]
  sales               Sale[]            @relation("SaleCreator")
  assignedProspects   Prospect[]        @relation("AssignedProspects")
  prospectActivities  ProspectActivity[]
  assignedInfluencers Influencer[]      @relation("AssignedInfluencers")
  influencerShipments InfluencerShipment[] @relation("InfluencerShipmentCreator")
  influencerPosts     InfluencerPost[]  @relation("InfluencerPostCreator")
  createdEvents       SellingEvent[]    @relation("EventCreator")
  eventSales          EventSale[]       @relation("EventSeller")

  @@index([role])
  @@index([supabaseId])
}

// -----------------------------
// Brand Voice Memory
// -----------------------------

model BrandVoice {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  isDefault           Boolean  @default(false)

  // Tone descriptors stored as JSON for flexibility
  toneDescriptors     Json     // ["reflective", "premium", "brotherhood-oriented", ...]
  approvedPhrases     String[] @default([])
  forbiddenPhrases    String[] @default([])
  theologicalGuard    String[] @default([])
  formattingRules     Json?    // e.g. {"emDash": true, "emojiPolicy": "minimal"}
  emotionalPositioning String? @db.Text
  exampleVoiceSamples Json?    // [{title, body}]

  // Vector embedding for semantic recall (pgvector extension)
  embedding           Unsupported("vector(3072)")?

  createdBy           User?    @relation(fields: [createdById], references: [id])
  createdById         String?

  contentPieces       ContentPiece[]
  campaigns           Campaign[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isDefault])
}

// -----------------------------
// Content
// -----------------------------

model ContentPiece {
  id              String        @id @default(cuid())
  title           String
  slug            String?       @unique
  type            ContentType
  status          ContentStatus @default(DRAFT)

  body            String        @db.Text
  excerpt         String?       @db.Text
  metadata        Json?         // {tone, goals, ctaIntensity, etc.}

  author          User          @relation("AuthoredContent", fields: [authorId], references: [id])
  authorId        String

  approvedBy      User?         @relation("ApprovedContent", fields: [approvedById], references: [id])
  approvedById    String?
  approvedAt      DateTime?

  brandVoice      BrandVoice?   @relation(fields: [brandVoiceId], references: [id])
  brandVoiceId    String?

  campaign        Campaign?     @relation(fields: [campaignId], references: [id])
  campaignId      String?

  variants        ContentVariant[]
  scheduledPosts  ScheduledPost[]
  assets          ContentAsset[]
  seoKeywords     ContentKeyword[]

  // Safety / compliance scoring
  shadowbanScore  Float?        // 0..1, lower = safer
  complianceFlags Json?         // [{flag, severity, suggestion}]

  // AI provenance
  aiGenerated     Boolean       @default(false)
  aiJobId         String?       @unique
  aiJob           AIJob?        @relation(fields: [aiJobId], references: [id])

  embedding       Unsupported("vector(3072)")?

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([authorId])
  @@index([campaignId])
}

model ContentVariant {
  id              String       @id @default(cuid())
  parent          ContentPiece @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId        String

  platform        Platform
  body            String       @db.Text
  hashtags        String[]     @default([])
  metadata        Json?
  characterCount  Int?

  shadowbanScore  Float?
  complianceFlags Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([parentId, platform])
}

// -----------------------------
// Campaigns
// -----------------------------

model Campaign {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?        @db.Text
  status          CampaignStatus @default(PLANNING)
  goalSummary     String?        @db.Text
  startDate       DateTime?
  endDate         DateTime?
  theme           String?
  colorAccent     String?        // hex for calendar grouping

  brandVoice      BrandVoice?    @relation(fields: [brandVoiceId], references: [id])
  brandVoiceId    String?

  owner           User           @relation(fields: [ownerId], references: [id])
  ownerId         String

  contentPieces   ContentPiece[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

// -----------------------------
// Platform Connections
// -----------------------------

model PlatformConnection {
  id              String   @id @default(cuid())
  platform        Platform
  label           String
  accountHandle   String?
  isActive        Boolean  @default(true)

  // Encrypted credential blob (encrypted at rest via app layer)
  credentials     Json
  scopes          String[] @default([])
  tokenExpiresAt  DateTime?

  scheduledPosts  ScheduledPost[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, accountHandle])
  @@index([platform])
}

// -----------------------------
// Scheduling
// -----------------------------

model ScheduledPost {
  id                String          @id @default(cuid())
  content           ContentPiece    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId         String

  platform          Platform
  connection        PlatformConnection? @relation(fields: [connectionId], references: [id])
  connectionId      String?

  scheduledFor      DateTime
  status            ScheduledStatus @default(QUEUED)
  qstashMessageId   String?
  externalPostId    String?         // ID returned from platform
  externalUrl       String?

  payload           Json            // Final rendered payload sent to platform
  errorMessage      String?         @db.Text
  attempts          Int             @default(0)
  publishedAt       DateTime?

  createdBy         User            @relation(fields: [createdById], references: [id])
  createdById       String

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([scheduledFor, status])
  @@index([platform])
}

// -----------------------------
// Telegram
// -----------------------------

model TelegramMember {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  username        String?
  firstName       String?
  lastName        String?
  isBot           Boolean  @default(false)
  isAmbassador    Boolean  @default(false)

  joinedAt        DateTime @default(now())
  leftAt          DateTime?

  messageCount    Int      @default(0)
  reactionCount   Int      @default(0)
  contributionScore Float  @default(0)
  lastActivityAt  DateTime?

  messages        TelegramMessage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([username])
  @@index([isAmbassador])
}

model TelegramMessage {
  id              String   @id @default(cuid())
  telegramMsgId   String
  chatId          String

  member          TelegramMember? @relation(fields: [memberId], references: [id])
  memberId        String?

  text            String?  @db.Text
  hasMedia        Boolean  @default(false)
  replyToId       String?
  threadId        String?

  reactions       Json?    // {emoji: count}
  metadata        Json?

  sentAt          DateTime
  createdAt       DateTime @default(now())

  @@unique([chatId, telegramMsgId])
  @@index([sentAt])
  @@index([memberId])
}

model TelegramDraft {
  id            String              @id @default(cuid())
  source        String              // "daily_reflection_cron" | "manual" | "scheduled"
  text          String              @db.Text
  parseMode     String              @default("HTML")
  theme         String?             // e.g. "ritual", "brotherhood", "silence" — used for prompt variation
  status        TelegramDraftStatus @default(PENDING)

  proposedFor   DateTime?           // When the AI thought this should ideally send
  sentAt        DateTime?
  sentToChatId  String?
  externalMsgId String?             // Telegram message_id once sent
  externalUrl   String?

  metadata      Json?               // prompt seed, tokens, model, cost

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
}

model CommunityEvent {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  location        String?
  locationLat     Float?
  locationLng     Float?
  startsAt        DateTime
  endsAt          DateTime?
  rsvpUrl         String?
  isDSA           Boolean  @default(false) // Dazos Smoking Association event
  imageUrl        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startsAt])
}

// -----------------------------
// Analytics
// -----------------------------

model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  platform        Platform
  capturedAt      DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime

  // Flexible metric storage
  metrics         Json     // {impressions, reach, engagement, ctr, ...}
  audience        Json?    // demographics snapshot
  topContentIds   String[] @default([])

  @@index([platform, periodStart])
}

// User-uploaded CSV imports from external analytics platforms (GA4, GSC,
// Meta Business Suite, etc). Each import is one CSV file representing a
// specific report type and date window.
model AnalyticsImport {
  id            String          @id @default(cuid())
  source        AnalyticsSource
  reportType    String          // ga4_traffic_acquisition, gsc_queries, instagram_content, etc.
  label         String?         // user-provided friendly name
  filename      String

  periodStart   DateTime?
  periodEnd     DateTime?
  rowCount      Int             @default(0)

  // Normalized data shape — see src/server/analytics/imports.ts
  totals        Json            // {clicks, impressions, users, reach, ...}
  timeseries    Json            // [{date, metric1, metric2, ...}]
  topEntities   Json            // [{name, url, metric1, metric2, ...}]
  metadata      Json?           // {columnsDetected, warnings, ...}

  uploadedBy    User            @relation(fields: [uploadedById], references: [id])
  uploadedById  String

  createdAt     DateTime        @default(now())

  @@index([source, periodEnd])
  @@index([uploadedById])
}

// -----------------------------
// Assets
// -----------------------------

model Asset {
  id              String     @id @default(cuid())
  filename        String
  storagePath     String     @unique // path in Supabase Storage
  publicUrl       String?
  mimeType        String
  byteSize        Int
  type            AssetType
  width           Int?
  height          Int?
  durationSec     Int?
  altText         String?
  caption         String?
  tags            String[]   @default([])

  uploadedBy      User       @relation(fields: [uploadedById], references: [id])
  uploadedById    String

  contentAssets   ContentAsset[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([type])
  @@index([uploadedById])
}

model ContentAsset {
  contentId  String
  assetId    String
  position   Int          @default(0)
  role       String?      // "hero", "carousel-1", etc.

  content    ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([contentId, assetId])
  @@index([contentId])
}

// -----------------------------
// SEO
// -----------------------------

model SEOKeyword {
  id              String   @id @default(cuid())
  keyword         String   @unique
  cluster         String?
  intent          String?  // informational | commercial | transactional | navigational
  searchVolume    Int?
  difficulty      Float?
  currentRank     Int?
  previousRank    Int?
  lastCheckedAt   DateTime?
  targetUrl       String?
  notes           String?  @db.Text

  contentLinks    ContentKeyword[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cluster])
}

model ContentKeyword {
  contentId  String
  keywordId  String
  isPrimary  Boolean      @default(false)

  content    ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  keyword    SEOKeyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([contentId, keywordId])
  @@index([keywordId])
}

// -----------------------------
// AI
// -----------------------------

model PromptTemplate {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  category        String   // caption | blog | devotional | telegram | seo | repurpose
  systemPrompt    String   @db.Text
  userPromptTpl   String   @db.Text
  variables       Json     // [{name, type, default}]
  defaultModel    String?
  defaultTemp     Float?   @default(0.7)
  isActive        Boolean  @default(true)
  version         Int      @default(1)

  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdById     String?

  jobs            AIJob[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

model AIJob {
  id              String      @id @default(cuid())
  status          AIJobStatus @default(PENDING)
  model           String
  template        PromptTemplate? @relation(fields: [templateId], references: [id])
  templateId      String?

  input           Json
  output          Json?
  rawText         String?     @db.Text
  errorMessage    String?     @db.Text

  // Token + cost tracking
  promptTokens    Int?
  completionTokens Int?
  totalTokens     Int?
  costUsd         Decimal?    @db.Decimal(10, 6)
  durationMs      Int?

  triggeredBy     User?       @relation(fields: [triggeredById], references: [id])
  triggeredById   String?

  content         ContentPiece?

  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())

  @@index([status])
  @@index([triggeredById])
}

// -----------------------------
// Workflows
// -----------------------------

model Workflow {
  id              String           @id @default(cuid())
  name            String
  description     String?          @db.Text
  trigger         WorkflowTrigger
  triggerConfig   Json?            // {event: "content.published", filter: {...}}
  steps           Json             // ordered array of step nodes
  isActive        Boolean          @default(true)

  owner           User             @relation(fields: [ownerId], references: [id])
  ownerId         String

  executions      WorkflowExecution[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([trigger])
  @@index([isActive])
}

model WorkflowExecution {
  id              String      @id @default(cuid())
  workflow        Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId      String

  status          AIJobStatus @default(PENDING)
  triggerPayload  Json?
  stepLog         Json?       // [{stepIndex, status, output, ms}]
  errorMessage    String?     @db.Text

  triggeredBy     User?       @relation(fields: [triggeredById], references: [id])
  triggeredById   String?

  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())

  @@index([workflowId, status])
}

// -----------------------------
// Audit
// -----------------------------

model AuditLog {
  id              String   @id @default(cuid())
  actor           User?    @relation(fields: [actorId], references: [id])
  actorId         String?

  action          String   // "content.created" | "post.scheduled" | ...
  entityType      String?
  entityId        String?
  diff            Json?
  ip              String?
  userAgent       String?

  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// -----------------------------
// Revenue Forecasting
// -----------------------------

model ForecastScenario {
  id                       String   @id @default(cuid())
  name                     String
  description              String?
  isDefault                Boolean  @default(false)

  // Editable variables (financial knobs)
  wholesaleBoxPrice        Decimal  @db.Decimal(10, 2)
  cigarsPerBox             Int
  landedCostPerCigar       Decimal  @db.Decimal(10, 4)
  brokerCommissionPct      Decimal  @db.Decimal(5, 4) // 0.15 = 15%
  numRetailAccounts        Int
  boxesPerOpeningOrder     Int
  reorderCycleWeeks        Int
  avgBoxesPerReorder       Int
  packagingImportBudget    Decimal  @db.Decimal(12, 2) @default(0)
  eventSalesPerMonth       Decimal  @db.Decimal(12, 2) @default(0)
  websiteOrdersPerMonth    Int      @default(0)
  websiteAvgOrderValue     Decimal  @db.Decimal(10, 2) @default(0)
  subscriptionMembers      Int      @default(0)
  subscriptionMonthlyPrice Decimal  @db.Decimal(10, 2) @default(0)

  createdBy                User?    @relation(fields: [createdById], references: [id])
  createdById              String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([isDefault])
}

// -----------------------------
// CRM
// -----------------------------

model Customer {
  id                String          @id @default(cuid())
  businessName      String
  dba               String?         // "doing business as" (optional)
  customerType      CustomerType
  source            LeadSource?
  status            CustomerStatus  @default(LEAD)

  // Primary contact
  contactName       String?
  contactTitle      String?
  email             String?
  mobile            String?
  phone             String?         // office phone

  // Business address (structured); `address` kept as legacy free-form
  address           String?
  street            String?
  city              String?
  state             String?
  zipCode           String?
  country           String?         @default("USA")

  // Sales information
  assignedTo        User?           @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  assignedToId      String?         // sales representative
  paymentTerms      String?         @default("Net 30")
  taxId             String?
  shippingMethod    String?

  tags              String[]        @default([])
  notes             String?         @db.Text
  lastContactDate   DateTime?
  nextFollowupDate  DateTime?
  archivedAt        DateTime?       // soft-delete / archive

  sales             Sale[]
  prospect          Prospect?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerType])
  @@index([status])
  @@index([assignedToId])
  @@index([nextFollowupDate])
  @@index([archivedAt])
  @@index([businessName])
  @@index([email])
}

// -----------------------------
// Inventory
// -----------------------------

model InventoryItem {
  id                      String                @id @default(cuid())
  sku                     String                @unique
  productName             String
  blend                   BlendType?
  blendCustom             String?               // for blend=CUSTOM

  packagingType           PackagingType
  unitsPerPackage         Int                   // e.g. 10 cigars per box

  packagesOnHand          Int                   @default(0)

  costPerUnit             Decimal               @db.Decimal(10, 4) // per cigar
  wholesalePrice          Decimal               @db.Decimal(10, 2) // per package
  retailPrice             Decimal               @db.Decimal(10, 2) @default(0)

  reorderThreshold        Int                   @default(0)   // packages
  preferredReorderQty     Int                   @default(0)   // packages

  supplier                String?
  location                String?
  status                  InventoryStatus       @default(ACTIVE)

  // Future-ready
  barcode                 String?
  notes                   String?               @db.Text

  adjustments             InventoryAdjustment[]
  saleItems               SaleItem[]
  eventItems              EventItem[]

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([status])
  @@index([blend])
  @@index([packagingType])
  @@index([sku])
}

model InventoryAdjustment {
  id              String              @id @default(cuid())

  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryItemId String

  // Positive = packages added (PURCHASE/RETURN/CORRECTION up)
  // Negative = packages removed (SALE/SAMPLE/DAMAGE/EVENT/CORRECTION down)
  packagesDelta   Int
  reason          AdjustmentReason

  notes           String?             @db.Text

  // Optional link back to the invoice that triggered the adjustment
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleId          String?

  createdBy       User?               @relation(fields: [createdById], references: [id])
  createdById     String?

  createdAt       DateTime            @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([reason])
  @@index([saleId])
}

// -----------------------------
// Sales — invoices with line items
// -----------------------------
// The invoicing system for wholesale. A Sale is an invoice tied to a
// Customer with N line items. Line items optionally reference an
// InventoryItem so inventory/purchasing/accounting can integrate later
// without a schema change. All money is Decimal; totals are computed
// server-side and persisted for cheap reporting at scale.

model Sale {
  id             String      @id @default(cuid())
  invoiceNumber  String      @unique             // e.g. INV-2026-00042
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String

  invoiceDate    DateTime    @default(now())
  dueDate        DateTime?
  status         SaleStatus  @default(DRAFT)
  source         SaleSource  @default(EMBEROS)
  externalRef    String?     // e.g. the QuickBooks invoice number

  // Persisted totals (recomputed on every item write)
  subtotal       Decimal     @db.Decimal(12, 2) @default(0)
  discountTotal  Decimal     @db.Decimal(12, 2) @default(0)   // order-level + line discounts
  taxTotal       Decimal     @db.Decimal(12, 2) @default(0)
  shipping       Decimal     @db.Decimal(12, 2) @default(0)
  grandTotal     Decimal     @db.Decimal(12, 2) @default(0)
  amountPaid     Decimal     @db.Decimal(12, 2) @default(0)
  paidAt         DateTime?

  notes          String?     @db.Text            // shown on the invoice
  internalNotes  String?     @db.Text            // team-only

  items          SaleItem[]
  adjustments    InventoryAdjustment[]

  createdBy      User?       @relation("SaleCreator", fields: [createdById], references: [id])
  createdById    String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([customerId, invoiceDate])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([externalRef])
}

model SaleItem {
  id              String         @id @default(cuid())
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId          String

  // Optional inventory link — enables auto-deduct + product reporting later
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryItemId String?

  product         String                          // denormalized product name
  quantity        Int
  unitPrice       Decimal        @db.Decimal(10, 2)
  discountPct     Decimal        @db.Decimal(5, 2) @default(0)  // 0–100
  taxPct          Decimal        @db.Decimal(5, 2) @default(0)  // 0–100
  lineTotal       Decimal        @db.Decimal(12, 2)             // qty*price*(1-disc)*(1+tax)
  sortOrder       Int            @default(0)

  @@index([saleId])
  @@index([inventoryItemId])
}

// -----------------------------
// Prospecting — sales intelligence
// -----------------------------
// Prospects are pre-customers: discovered or imported cigar lounges /
// retailers moving through the sales pipeline. AI enrichment + scoring
// results are stored inline (Json for the full briefing) so profiles
// render without re-calling OpenAI. Converting creates a Customer and
// links the two records.

enum ProspectStage {
  LEAD
  QUALIFIED
  CONTACTED
  MEETING_SCHEDULED
  MEETING_COMPLETED
  SAMPLES_DELIVERED
  NEGOTIATION
  FIRST_ORDER
  ACTIVE_CUSTOMER
  VIP_CUSTOMER
  LOST
}

enum ProspectVerdict {
  PURSUE
  MAYBE
  SKIP
}

enum ProspectActivityKind {
  CALL
  MEETING
  EMAIL
  SMS
  NOTE
  TASK
  SAMPLE
  VISIT
}

model Prospect {
  id               String          @id @default(cuid())
  businessName     String
  dba              String?
  businessType     String?         // "Retail", "Retail + lounge", "Private club", "Membership lounge"

  street           String?
  city             String?
  state            String?
  zipCode          String?
  country          String?         @default("USA")
  latitude         Float?
  longitude        Float?

  phone            String?
  email            String?
  website          String?
  instagram        String?
  facebook         String?
  linkedin         String?
  twitter          String?
  youtube          String?
  yelp             String?
  googleProfile    String?
  googleRating     Float?
  reviewCount      Int?
  businessHours    String?
  description      String?         @db.Text

  // Contacts
  ownerName        String?
  buyerName        String?
  managerName      String?
  contactPhone     String?
  contactEmail     String?
  preferredContact String?         // "call" | "email" | "text" | "visit"

  // Business details
  humidorSize      String?         // "small" | "medium" | "large" | "walk-in"
  footTraffic      String?
  demographic      String?
  locationCount    Int?

  // Pipeline
  stage            ProspectStage   @default(LEAD)
  assignedTo       User?           @relation("AssignedProspects", fields: [assignedToId], references: [id])
  assignedToId     String?
  territory        String?
  lastContactDate  DateTime?
  nextFollowupDate DateTime?

  // AI intelligence
  aiScore          Int?            // 0–100 Heaven's Leaf compatibility
  aiScoreReason    String?         @db.Text
  aiDna            String[]        @default([])   // lounge DNA tags
  aiVerdict        ProspectVerdict?
  aiPriority       String?         // "HIGH" | "MEDIUM" | "LOW"
  aiFirstOrderEst  Decimal?        @db.Decimal(10, 2)
  aiAnnualEst      Decimal?        @db.Decimal(12, 2)
  aiWinProbability Int?            // 0–100
  aiBriefing       Json?           // full structured sales briefing
  aiEnrichment     Json?           // discovered links/info + confidence
  aiAnalyzedAt     DateTime?

  // ICP scoring — rep-answered checklist (criteria/weights in src/lib/icp.ts)
  icpAnswers        Json?          // raw answers keyed by criterion key
  icpScore          Int?           // 0–100, computed server-side from answers
  icpScoredAt       DateTime?
  currentBrands     String?        @db.Text
  facingsCount      Int?
  loungeSeats       Int?
  decisionMakerName String?
  decisionMakerRole String?
  lastVisitDate     DateTime?
  icpNotes          String?        @db.Text

  tags             String[]        @default([])
  notes            String?         @db.Text
  archivedAt       DateTime?

  // Set when converted to a real customer
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId       String?         @unique

  activities       ProspectActivity[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([stage])
  @@index([state, city])
  @@index([aiScore])
  @@index([icpScore])
  @@index([lastVisitDate])
  @@index([assignedToId])
  @@index([nextFollowupDate])
  @@index([archivedAt])
  @@index([businessName])
}

model ProspectActivity {
  id          String               @id @default(cuid())
  prospect    Prospect             @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId  String

  kind        ProspectActivityKind
  summary     String
  detail      String?              @db.Text
  dueAt       DateTime?            // for TASK / follow-ups
  completedAt DateTime?

  createdBy   User?                @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime             @default(now())

  @@index([prospectId, createdAt])
  @@index([dueAt])
}

// -----------------------------
// Influencer Relationships — cigar seeding + post tracking
// -----------------------------
// Influencers move from prospect to active partner. Each cigar shipment
// and each resulting post is logged so the profile shows what was sent
// vs. what content came back.

enum InfluencerStage {
  PROSPECT
  CONTACTED
  IN_CONVERSATION
  AGREED
  CIGARS_SENT
  ACTIVE_PARTNER
  INACTIVE
  DECLINED
}

enum InfluencerPostType {
  POST
  STORY
  REEL
  VIDEO
  LIVE
  UNBOXING
  REVIEW
  GIVEAWAY
  MENTION
  OTHER
}

model Influencer {
  id             String   @id @default(cuid())
  name           String            // display name from the profile
  handle         String?           // without the @
  platform       String   @default("Instagram")
  profileUrl     String?

  // Audience snapshot (from screenshot or manual entry)
  followerCount  Int?
  followingCount Int?
  postCount      Int?              // lifetime posts shown on their profile
  niche          String?           // "cigar lifestyle", "whiskey", "golf"…
  bio            String?  @db.Text
  location       String?

  // Contact
  email          String?
  phone          String?
  otherSocials   String?

  // Relationship
  stage            InfluencerStage @default(PROSPECT)
  assignedTo       User?           @relation("AssignedInfluencers", fields: [assignedToId], references: [id])
  assignedToId     String?
  lastContactDate  DateTime?
  nextFollowupDate DateTime?
  agreementTerms   String?         @db.Text  // e.g. "2 reels + 3 stories per shipment"

  tags           String[] @default([])
  notes          String?  @db.Text
  archivedAt     DateTime?

  shipments      InfluencerShipment[]
  posts          InfluencerPost[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([stage])
  @@index([handle])
  @@index([name])
  @@index([assignedToId])
  @@index([nextFollowupDate])
  @@index([archivedAt])
}

model InfluencerShipment {
  id             String     @id @default(cuid())
  influencer     Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId   String

  sentAt         DateTime   @default(now())
  cigarCount     Int
  contents       String?    @db.Text  // which cigars / SKUs went in the box
  costUsd        Decimal?   @db.Decimal(10, 2)
  carrier        String?
  trackingNumber String?
  deliveredAt    DateTime?
  notes          String?    @db.Text

  createdBy      User?      @relation("InfluencerShipmentCreator", fields: [createdById], references: [id])
  createdById    String?
  createdAt      DateTime   @default(now())

  @@index([influencerId, sentAt])
}

model InfluencerPost {
  id           String             @id @default(cuid())
  influencer   Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId String

  postedAt     DateTime           @default(now())
  type         InfluencerPostType @default(POST)
  url          String?
  caption      String?            @db.Text
  likes        Int?
  comments     Int?
  views        Int?
  notes        String?            @db.Text

  createdBy    User?              @relation("InfluencerPostCreator", fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime           @default(now())

  @@index([influencerId, postedAt])
  @@index([type])
}

// -----------------------------
// Event Mode — sell cigars live at events (tap or voice tally)
// -----------------------------

enum SellingEventStatus {
  UPCOMING
  LIVE
  CLOSED
}

enum EventSaleSource {
  TAP
  VOICE
}

model SellingEvent {
  id       String             @id @default(cuid())
  name     String
  venue    String?
  startsAt DateTime
  status   SellingEventStatus @default(UPCOMING)
  notes    String?            @db.Text

  createdBy           User?     @relation("EventCreator", fields: [createdById], references: [id])
  createdById         String?
  closedAt            DateTime?
  sealedAt            DateTime? // sealed = permanent record: no reopen, no delete
  inventoryDeductedAt DateTime? // set once sealing has deducted linked stock

  items EventItem[]
  sales EventSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

model EventItem {
  id      String       @id @default(cuid())
  event   SellingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  label      String
  unitPrice  Decimal @db.Decimal(10, 2)
  qtyBrought Int     @default(0)
  sortOrder  Int     @default(0)

  // Optional link — enables price prefill + close-out stock deduction
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryItemId String?

  sales EventSale[]

  createdAt DateTime @default(now())

  @@index([eventId, sortOrder])
}

model EventSale {
  id      String       @id @default(cuid())
  event   SellingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  item    EventItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId  String

  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2) // price at the moment of sale

  soldBy   User?   @relation("EventSeller", fields: [soldById], references: [id])
  soldById String?

  source     EventSaleSource @default(TAP)
  transcript String?         // voice sales keep the raw words for audit

  soldAt DateTime @default(now())

  @@index([eventId, soldAt])
  @@index([itemId])
}
